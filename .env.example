# ==============================================================================
# AgriSmart AI Environment Configuration
# Copy this file to .env and configure for your environment
# ==============================================================================

# Core Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Hostnames & Domains
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Configuration (PostgreSQL via DATABASE_URL; falls back to SQLite if empty)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# Frontend URL for CORS and CSRF (e.g. Vercel deployment URL)
FRONTEND_URL=http://localhost:5173

# Optional additional CORS / CSRF allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather API Configuration
WEATHER_CACHE_TIMEOUT=1800
WEATHER_API_KEY=your-weatherapi-key-here
WEATHER_PROVIDER=weatherapi

# Groq LLM Configuration (AI Agronomist Assistant)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Email Configuration (Optional SMTP credentials)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Server Port (automatically set by Render/Heroku/Railway)
PORT=8000
